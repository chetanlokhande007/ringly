<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ringly.Api</RootNamespace>
    <!-- Repo root, where package.json / vite.spa.config.ts live -->
    <SpaRoot>$(MSBuildProjectDirectory)/../../</SpaRoot>
    <BuildSpaOnPublish Condition="'$(BuildSpaOnPublish)' == ''">true</BuildSpaOnPublish>
    <NpmCommand Condition="'$(NpmCommand)' == ''">npm</NpmCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Never ship a stale wwwroot from source control -->
  <ItemGroup>
    <Content Remove="wwwroot/**" />
  </ItemGroup>

  <!--
    Publish pipeline: build the React app with the SPA vite config, which emits
    straight into wwwroot, then include every generated file in the publish output.
    Result: one `dotnet publish` ships frontend + API on the same domain.
  -->
  <Target Name="BuildReactApp" BeforeTargets="ComputeFilesToPublish" Condition="'$(BuildSpaOnPublish)' == 'true'">
    <Message Importance="high" Text="Installing npm packages..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="$(NpmCommand) install" />
    <Message Importance="high" Text="Building React SPA into wwwroot..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="$(NpmCommand) run build:spa" />
  </Target>

  <Target Name="IncludeReactAppInPublish" AfterTargets="BuildReactApp" Condition="'$(BuildSpaOnPublish)' == 'true'">
    <ItemGroup>
      <SpaFiles Include="$(MSBuildProjectDirectory)/wwwroot/**" />
      <ResolvedFileToPublish Include="@(SpaFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
